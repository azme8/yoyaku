    let chatDbRef = null;

    function setupChatListener() {
      if (chatDbRef) chatDbRef.off();
      const targetBand = isAdmin ? selectedAdminChatBand : currentLoginBand;
      if (!targetBand) {
        document.getElementById('chatMessagesContainer').innerHTML = '<span style="color: #7f8c8d; font-size: 11px;">チャットする相手を選択してください。</span>';
        return;
      }

      isInitialChatLoad = true;
      chatDbRef = db.ref(`chats/${targetBand}`);
      chatDbRef.limitToLast(50).on('value', (snapshot) => {
        const data = snapshot.val();
        const container = document.getElementById('chatMessagesContainer');
        container.innerHTML = '';
        if (!data) {
          container.innerHTML = '<span style="color: #7f8c8d; font-size: 11px;">メッセージはありません。</span>';
          return;
        }

        const msgList = Object.values(data);
        msgList.forEach(msg => {
          const div = document.createElement('div');
          div.className = 'chat-msg';
          div.innerHTML = `<b>${msg.sender}</b>: ${msg.text} <span style="font-size: 9px; color: #999; float: right;">${msg.time}</span>`;
          container.appendChild(div);
        });
        container.scrollTop = container.scrollHeight;

        if (!isInitialChatLoad && msgList.length > 0) {
          const lastMsg = msgList[msgList.length - 1];
          if (lastMsg.sender !== currentLoginBand) {
            playNotificationSound();
            const badge = document.getElementById('chatNotificationBadge');
            badge.style.display = 'block';
            setTimeout(() => { badge.style.display = 'none'; }, 4000);

            if ("Notification" in window && Notification.permission === "granted") {
              new Notification(`[新着チャット] ${lastMsg.sender}`, {
                body: lastMsg.text
              });
            }
          }
        }
        isInitialChatLoad = false;
      });
    }

