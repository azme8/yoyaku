    }

    function executeBooking() {
      if (!targetBookingKey || !currentLoginBand) return;

      let bookingName = currentLoginBand;
      if (isAdmin) {
        const customName = document.getElementById('inputAdminBookingName').value.trim();
        if (customName) bookingName = customName;
      }

      const weekData = (allReservations[currentRoom] || {})[currentWeek] || {};
      
      // 管理者以外は「1週間に1コマまで」の重複チェック
      if (!isAdmin) {
        if (Object.values(weekData).includes(currentLoginBand)) {
          closeBookingModal();
          showInfoModal('予約エラー', `「${currentLoginBand}」は今週この部室ですでに予約しています。`, true);
          return;
        }
      }

      db.ref(`reservations/${currentRoom}/${currentWeek}/${targetBookingKey}`).set(bookingName);
      
      const roomLabel = roomNames[currentRoom] || (currentRoom === 'floor4' ? '4階部室' : '3階部室');
      const weekLabel = currentWeek === 'thisWeek' ? '今週' : '来週';
      logAction(`[${roomLabel}/${weekLabel}] ${bookingName} が予約しました`);

      closeBookingModal();
      showInfoModal('予約完了', `「${bookingName}」で予約完了しました！`);
    }

