    function sendChatMessage() {
      const input = document.getElementById('chatInputMessage');
      const text = input.value.trim();
      const targetBand = isAdmin ? selectedAdminChatBand : currentLoginBand;

      if (!targetBand) {
        showInfoModal('送信エラー', 'チャットするバンドが選択されていません。', true);
        return;
      }
      if (!text) return;

      const now = new Date();
      const timeStr = `${String(now.getHours()).padStart(2, '0')}:${String(now.getMinutes()).padStart(2, '0')}`;

      db.ref(`chats/${targetBand}`).push({
        sender: currentLoginBand,
        text: text,
        time: timeStr
      });

      input.value = '';
    }

    // ==========================================
