    function renderTable() {
      const tbody = document.getElementById('timetableBody');
      tbody.innerHTML = '';
      const slots = floorTimes[currentRoom] || defaultFloorTimesStruct[currentRoom];

      slots.forEach((item, idx) => {
        const slotLabel = item.slotLabel || `コマ${idx + 1}`;
        const slotKeyId = `コマ${idx + 1}`;
        const tr = document.createElement('tr');
        const tdTime = document.createElement('td');
        tdTime.className = 'time-col';
        tdTime.innerHTML = `<span>${slotLabel}</span><br>${item.nameA || 'A'}:${item.a}<br>${item.nameB || 'B'}:${item.b}<br>${item.nameAM || 'AM'}:${item.am}<br>${item.nameLong || '長期'}:${item.long}` +
          `<button class="row-delete-btn" onclick="openTimeRowDeleteConfirmModal(${idx}, event)" title="この行を削除">削除</button>`;
        tdTime.onclick = () => { if (isAdmin) openTimeModal(idx); };
        tr.appendChild(tdTime);

        days.forEach(day => {
          const td = document.createElement('td');
          td.className = 'slot';
          const key = `${day}_${slotKeyId}`;
          const bookedName = ((allReservations[currentRoom] || {})[currentWeek] || {})[key] || '';
          if (bookedName) {
            // 管理者が登録した名前（"管理者" または registeredBandsに存在しない名前、または手動で「管理者」と入力されたものなど、あるいは明確に管理者判定）
            // ここでは管理者が予約した際に登録される名前や、名前に「管理者」が含まれるか、または一般バンド以外の予約名の場合は管理者予約（赤色）とする
            const isRegisteredBand = registeredBands.some(b => b.name === bookedName);
            if (!isRegisteredBand || bookedName.includes("管理者") || bookedName === "管理者") {
              td.classList.add('booked-admin');
            } else {
              td.classList.add('booked');
            }
            td.innerText = bookedName;
          } else {
            td.classList.add('free');
            td.innerText = '○';
          }
          td.onclick = () => handleSlotClick(key, bookedName);
          tr.appendChild(td);
        });
        tbody.appendChild(tr);
      });
    }

    function handleSlotClick(key, currentName) {
      if (currentName) return; 
      if (!currentLoginBand) {
        showInfoModal('予約エラー', 'ログインしてください。', true);
        return;
      }

      targetBookingKey = key;
      const roomLabel = roomNames[currentRoom] || (currentRoom === 'floor4' ? '4階部室' : '3階部室');
      const weekLabel = currentWeek === 'thisWeek' ? '今週' : '来週';
      document.getElementById('bookingModalTitle').innerText = `【${roomLabel} / ${weekLabel}】 予約確認`;

      const adminArea = document.getElementById('adminBookingNameArea');
      if (isAdmin) {
        adminArea.style.display = 'block';
        document.getElementById('inputAdminBookingName').value = "管理者";
        document.getElementById('bookingConfirmText').innerHTML = `管理者は何コマでも予約できます。予約名を入力してください：`;
      } else {
        adminArea.style.display = 'none';
        document.getElementById('bookingConfirmText').innerHTML = `「<b>${currentLoginBand}</b>」としてこのコマを予約しますか？`;
      }

      document.getElementById('bookingModal').style.display = 'flex';
    }

    function closeBookingModal() {
