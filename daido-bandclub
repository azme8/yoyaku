      document.getElementById('nameA').value = item.nameA || 'A日課';
      document.getElementById('inputA').value = item.a || '';
      document.getElementById('nameB').value = item.nameB || 'B日課';
      document.getElementById('inputB').value = item.b || '';
      document.getElementById('nameAM').value = item.nameAM || 'AM授業';
      document.getElementById('inputAM').value = item.am || '';
      document.getElementById('nameLong').value = item.nameLong || '長期休業';
      document.getElementById('inputLong').value = item.long || '';
      document.getElementById('timeModal').style.display = 'flex';
    }

    function closeTimeModal() { document.getElementById('timeModal').style.display = 'none'; }

    function saveTimeModal() {
      if (editingTimeIdx === null) return;
      const slots = floorTimes[currentRoom] || defaultFloorTimesStruct[currentRoom];
      slots[editingTimeIdx] = {
        slotLabel: document.getElementById('inputSlotLabel').value.trim() || `コマ${editingTimeIdx + 1}`,
        nameA: document.getElementById('nameA').value.trim() || 'A日課',
        a: document.getElementById('inputA').value.trim(),
        nameB: document.getElementById('nameB').value.trim() || 'B日課',
        b: document.getElementById('inputB').value.trim(),
        nameAM: document.getElementById('nameAM').value.trim() || 'AM授業',
        am: document.getElementById('inputAM').value.trim(),
        nameLong: document.getElementById('nameLong').value.trim() || '長期休業',
        long: document.getElementById('inputLong').value.trim()
      };
      floorTimes[currentRoom] = slots;
      db.ref('floorTimes').set(floorTimes);
      closeTimeModal();
      logAction(`時間割コマの情報を変更しました`);
      showInfoModal('保存完了', '時間割を変更しました！');
    }

    function renderOrgBoxes() {
      const container = document.getElementById('orgBoxesContainer');
      container.innerHTML = '';
      currentOrgBoxes.forEach((box, index) => {
        const textColor = box.textColor || '#333333';
        const borderColor = box.borderColor || '#2980b9';
        const div = document.createElement('div');
        div.className = `org-box`;
        div.style.borderColor = borderColor;
        div.setAttribute('data-id', box.id || 'box_' + index);
        div.innerHTML = `
          <div class="org-box-title" style="background: ${borderColor};">${box.title}</div>
          <div class="org-box-content" style="color: ${textColor};">${box.content}</div>
          <div class="box-btn-group">
            <span style="font-size: 9px; color: #666;">枠</span>
            <input type="color" class="color-picker-input" value="${borderColor}" onchange="changeBorderColor(${index}, this.value)" title="枠線色">
            <span style="font-size: 9px; color: #666; margin-left: 2px;">字</span>
            <input type="color" class="color-picker-input" value="${textColor}" onchange="changeTextColor(${index}, this.value)" title="文字色">
            <button class="edit-btn" onclick="openOrgModal(${index})">編集</button>
            <button class="delete-btn" onclick="openOrgDeleteConfirmModal(${index})">削除</button>
          </div>
        `;
        container.appendChild(div);
      });

      if (sortableInstance) sortableInstance.destroy();
      sortableInstance = new Sortable(container, {
        animation: 150,
        disabled: !isAdmin,
        onEnd: function () {
          const newOrdered = [];
          for (let i = 0; i < container.children.length; i++) {
            const id = container.children[i].getAttribute('data-id');
            const found = currentOrgBoxes.find(b => (b.id || '') === id);
            if (found) newOrdered.push(found);
          }
          currentOrgBoxes = newOrdered;
          db.ref('orgBoxes').set(currentOrgBoxes);
          logAction('組織図の並び順を変更しました');
        }
      });
    }

    function openOrgModal(index) {
      editingOrgIdx = index;
      document.getElementById('orgModalTitle').value = currentOrgBoxes[index].title;
      document.getElementById('orgModalContent').value = currentOrgBoxes[index].content;
      document.getElementById('orgModal').style.display = 'flex';
    }
    function closeOrgModal() { document.getElementById('orgModal').style.display = 'none'; }
    function saveOrgModal() {
      if (editingOrgIdx === null) return;
      currentOrgBoxes[editingOrgIdx].title = document.getElementById('orgModalTitle').value.trim();
      currentOrgBoxes[editingOrgIdx].content = document.getElementById('orgModalContent').value.trim();
      db.ref('orgBoxes').set(currentOrgBoxes);
      closeOrgModal();
      logAction(`組織図「${currentOrgBoxes[editingOrgIdx].title}」を更新しました`);
      showInfoModal('保存完了', '組織図を更新しました！');
    }

    function changeTextColor(index, colorHex) {
      currentOrgBoxes[index].textColor = colorHex;
      db.ref('orgBoxes').set(currentOrgBoxes);
      logAction(`組織図の文字色を変更しました`);
    }

    function changeBorderColor(index, colorHex) {
      currentOrgBoxes[index].borderColor = colorHex;
      db.ref('orgBoxes').set(currentOrgBoxes);
      logAction(`組織図の枠色を変更しました`);
    }

    function openOrgUnifiedColorModal() {
      document.getElementById('orgUnifiedColorModal').style.display = 'flex';
    }

    function closeOrgUnifiedColorModal() {
      document.getElementById('orgUnifiedColorModal').style.display = 'none';
    }

    function executeUnifiedOrgColor() {
      const unifiedColor = document.getElementById('inputUnifiedColor').value;
      currentOrgBoxes.forEach(box => {
        box.borderColor = unifiedColor;
      });
      db.ref('orgBoxes').set(currentOrgBoxes);
      closeOrgUnifiedColorModal();
      logAction(`組織図の枠線を色(${unifiedColor})に一括統一しました`);
      showInfoModal('一括適用完了', 'すべての組織図カードの枠線を統一しました！');
    }

    function executeResetInitialOrgColor() {
      const initialColor = "#2980b9";
      currentOrgBoxes.forEach(box => {
        box.borderColor = initialColor;
      });
      db.ref('orgBoxes').set(currentOrgBoxes);
      closeOrgUnifiedColorModal();
      logAction('組織図の枠色を最初の初期カラーにリセットしました');
      showInfoModal('リセット完了', '組織図の枠色を最初の初期カラーに戻しました！');
    }

    function openOrgDeleteConfirmModal(index) {
      targetDeleteOrgIndex = index;
      document.getElementById('orgDeleteConfirmText').innerHTML = `「<b>${currentOrgBoxes[index].title}</b>」を削除しますか？`;
      document.getElementById('orgDeleteConfirmModal').style.display = 'flex';
    }
    function closeOrgDeleteConfirmModal() { document.getElementById('orgDeleteConfirmModal').style.display = 'none'; targetDeleteOrgIndex = null; }
    function executeDeleteOrgBox() {
      if (targetDeleteOrgIndex === null) return;
      const target = currentOrgBoxes[targetDeleteOrgIndex];
      currentOrgBoxes.splice(targetDeleteOrgIndex, 1);
      db.ref('orgBoxes').set(currentOrgBoxes);
      closeOrgDeleteConfirmModal();
      logAction(`組織図「${target.title}」を削除しました`);
      showInfoModal('削除完了', '項目を削除しました。');
    }

    function openAddOrgModal() {
      document.getElementById('orgAddModalTitle').value = '';
      document.getElementById('orgAddModalContent').value = '';
      document.getElementById('orgAddModal').style.display = 'flex';
    }
    function closeAddOrgModal() { document.getElementById('orgAddModal').style.display = 'none'; }
    function executeAddOrgBox() {
      const title = document.getElementById('orgAddModalTitle').value.trim();
      const content = document.getElementById('orgAddModalContent').value.trim();
      if (!title) { showInfoModal('エラー', 'タイトルを入力してください', true); return; }
      currentOrgBoxes.push({ id: 'box_' + Date.now(), title, content, type: '', textColor: '#333333', borderColor: '#2980b9' });
      db.ref('orgBoxes').set(currentOrgBoxes);
      closeAddOrgModal();
      logAction(`組織図に新規項目「${title}」を追加しました`);
      showInfoModal('追加完了', '項目を追加しました！');
    }

    function openOrgHeaderModal() { document.getElementById('orgHeaderInput').value = orgHeaderTitle; document.getElementById('orgHeaderModal').style.display = 'flex'; }
    function closeOrgHeaderModal() { document.getElementById('orgHeaderModal').style.display = 'none'; }
    function saveOrgHeaderModal() {
      const val = document.getElementById('orgHeaderInput').value.trim();
      if (!val) return;
      db.ref('orgHeaderTitle').set(val);
      closeOrgHeaderModal();
      logAction('組織図タイトルを変更しました');
      showInfoModal('保存完了', 'タイトルを変更しました！');
    }

    function openCancelModal() {
      const container = document.getElementById('cancelListContainer');
      container.innerHTML = '';
      const weekData = (allReservations[currentRoom] || {})[currentWeek] || {};
      const slots = floorTimes[currentRoom] || defaultFloorTimesStruct[currentRoom];
      let count = 0;
      slots.forEach((item, i) => {
        const slotLabel = item.slotLabel || `コマ${i + 1}`;
        const slotKeyId = `コマ${i + 1}`;
        days.forEach(day => {
          const key = `${day}_${slotKeyId}`;
          if (weekData[key]) {
            count++;
            const bandName = weekData[key];
            const div = document.createElement('div');
            div.className = 'list-item';
            div.innerHTML = `<span><b>${dayNames[day]}曜 ${slotLabel}</b> : ${bandName}</span><button class="btn" style="background-color: #e74c3c; color: white; padding: 3px 8px; font-size: 11px;" onclick="openCancelConfirmModal('${key}', '${bandName}')">取消</button>`;
            container.appendChild(div);
          }
        });
      });
      if (count === 0) container.innerHTML = '<p style="text-align: center; color: #7f8c8d; font-size: 12px; padding: 10px;">予約はありません。</p>';
      document.getElementById('cancelModal').style.display = 'flex';
    }
    function closeCancelModal() { document.getElementById('cancelModal').style.display = 'none'; }

    function openCancelConfirmModal(key, bandName) {
      targetCancelKey = key;
      document.getElementById('cancelConfirmText').innerHTML = `「<b>${bandName}</b>」の予約をキャンセルしますか？`;
      document.getElementById('cancelConfirmModal').style.display = 'flex';
    }
    function closeCancelConfirmModal() { document.getElementById('cancelConfirmModal').style.display = 'none'; targetCancelKey = null; }
    function executeCancelReservation() {
      if (!targetCancelKey) return;
      db.ref(`reservations/${currentRoom}/${currentWeek}/${targetCancelKey}`).remove();
      closeCancelConfirmModal();
      openCancelModal();
      logAction('予約をキャンセルしました');
      showInfoModal('完了', '予約をキャンセルしました。');
    }

    function confirmResetCurrentWeek() {
      document.getElementById('resetWeekConfirmText').innerHTML = `今週の全リセットしますか？`;
      document.getElementById('resetWeekConfirmModal').style.display = 'flex';
    }
    function closeResetWeekConfirmModal() { document.getElementById('resetWeekConfirmModal').style.display = 'none'; }
    function executeResetCurrentWeek() {
      db.ref(`reservations/${currentRoom}/${currentWeek}`).remove();
      closeResetWeekConfirmModal();
      logAction('全予約をリセットしました');
      showInfoModal('リセット完了', 'リセットしました。');
    }

    function openContactModal() {
      document.getElementById('contactTextarea').value = contactText;
      document.getElementById('contactModal').style.display = 'flex';
    }
    function closeContactModal() { document.getElementById('contactModal').style.display = 'none'; }
    function saveContactModal() {
      const val = document.getElementById('contactTextarea').value.trim();
      db.ref('contactInfo').set(val);
      closeContactModal();
      logAction('お問い合わせ先を変更しました');
      showInfoModal('保存完了', '保存しました！');
    }
  </script>
</body>
</html>
